# =========================================================
# UBAYHUB BLORA - ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================

# Application Info & Host Configuration
NODE_ENV="production"
PORT=3000
APP_NAME="UbayHub Blora"
APP_TAGLINE="Toko Elektronik Online & Offline Terlengkap di Blora"
APP_URL="https://ubayhub.id"

# Security & Admin Authentication (Argon2 / JWT)
JWT_SECRET="ubayhub_super_secret_jwt_token_key_2026_blora_electronics"
JWT_EXPIRES_IN="24h"
ARGON2_SALT_ROUNDS=12
ADMIN_DEFAULT_USER="ubay_master"
ADMIN_DEFAULT_PASS="ubay123456"

# Google Gemini AI Repair Diagnostics Engine
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Payment Gateways (ShopeePay, DANA, GoPay, QRIS, Crypto, Bank Transfer)
QRIS_MERCHANT_ID="ID1020304050607"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxx"
DANA_MERCHANT_ID="2100987654321"
GOPAY_MERCHANT_ID="GOPAY-UBAYHUB-88"
SHOPEEPAY_MERCHANT_ID="SP-BLORA-001"
CRYPTO_TRC20_WALLET="0x71C7656EC7ab88b098defB751B7401B5f6d8976F"

# Marketplace & Affiliate Links (Shopee, TikTok, Tokopedia)
SHOPEE_AFFILIATE_ID="UBAYHUB_SHOPEE_AFF_88"
TIKTOK_AFFILIATE_ID="UBAYHUB_TIKTOK_SHOP_88"
TOKOPEDIA_AFFILIATE_ID="UBAYHUB_TOKOPEDIA_AFF_88"

# Anti-Link Mati Firmware Download System
FIRMWARE_CDN_PRIMARY="https://cdn.ubayhub.id/firmware/"
FIRMWARE_TOKEN_EXPIRE_MINUTES=15

# Database & Cache (Optional External PostgreSQL / Redis)
DATABASE_URL="postgresql://ubay_user:secure_password@localhost:5432/ubayhub_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Advertising & Analytics
GOOGLE_ADSENSE_PUB_ID="ca-pub-1234567890123456"
GOOGLE_ANALYTICS_ID="G-UBAYHUBBLORA"
